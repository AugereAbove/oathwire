{
  "name": "oathwire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/local.ts",
    "dev:web": "npm run dev -w @oathwire/web",
    "typecheck": "tsc --noEmit && npm run typecheck -w @oathwire/web",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs && npm run build -w @oathwire/web",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@codegenie/serverless-express": "^4.17.0",
    "aws-jwt-verify": "^5.1.1",
    "express": "^5.3.0",
    "ipaddr.js": "^2.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "globals": "^17.4.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  }
}
